  "fonts": {
    "sans": "'DM Sans', sans-serif",
    "serif": "Georgia, serif",
    "mono": "Menlo, monospace",
    "display": "'Bricolage Grotesque', sans-serif"
  },
  "typography": {
    "headingFontFamily": "var(--app-font-display)",
    "headingFontWeight": 800,
    "bodyFontFamily": "var(--app-font-sans)"
  },
  "radius": {
    "base": "0.25rem",
    "scale": {
      "sm": "calc(var(--radius) - 2px)",
      "md": "var(--radius)",
      "lg": "calc(var(--radius) + 2px)",
      "xl": "calc(var(--radius) + 4px)"
    }
  },
  "shadows": {
    "light": {
      "2xs": {
        "raw": "1px 1px 0px 0px hsl(var(--foreground))",
        "resolved": "1px 1px 0px 0px #2E1C0F"
      },
      "xs": {
        "raw": "2px 2px 0px 0px hsl(var(--foreground))",
        "resolved": "2px 2px 0px 0px #2E1C0F"
      },
      "sm": {
        "raw": "4px 4px 0px 0px hsl(var(--foreground))",
        "resolved": "4px 4px 0px 0px #2E1C0F"
      },
      "DEFAULT": {
        "raw": "6px 6px 0px 0px hsl(var(--foreground))",
        "resolved": "6px 6px 0px 0px #2E1C0F"
      },
      "md": {
        "raw": "8px 8px 0px 0px hsl(var(--foreground))",
        "resolved": "8px 8px 0px 0px #2E1C0F"
      },
      "lg": {
        "raw": "12px 12px 0px 0px hsl(var(--foreground))",
        "resolved": "12px 12px 0px 0px #2E1C0F"
      },
      "xl": {
        "raw": "16px 16px 0px 0px hsl(var(--foreground))",
        "resolved": "16px 16px 0px 0px #2E1C0F"
      },
      "2xl": {
