  "fonts": {
    "sans": "'DM Sans', sans-serif",
    "serif": "Georgia, serif",
    "mono": "Menlo, monospace",
    "display": "'Platypi', sans-serif"
  },
  "typography": {
    "headingFontFamily": "var(--app-font-display)",
    "headingFontWeight": 800,
    "bodyFontFamily": "var(--app-font-sans)",
    "scale": {
      "display": {
        "size": "8rem",
        "sizePx": 128,
        "lineHeight": 0.9,
        "fontKey": "display",
        "fontFamily": "var(--app-font-display)",
        "fontWeight": 800,
        "textTransform": "none",
        "letterSpacing": "-0.02em"
      },
      "h1": {
        "size": "4.5rem",
        "sizePx": 72,
        "lineHeight": 1,
        "fontKey": "display",
        "fontFamily": "var(--app-font-display)",
        "fontWeight": 800,
        "textTransform": "none",
        "letterSpacing": "-0.02em"
      },
      "h2": {
        "size": "3rem",
        "sizePx": 48,
        "lineHeight": 1.05,
        "fontKey": "display",
        "fontFamily": "var(--app-font-display)",
        "fontWeight": 800,
        "textTransform": "none",
        "letterSpacing": "-0.01em"
      },
      "h3": {
        "size": "2.25rem",
        "sizePx": 36,
        "lineHeight": 1.1,
        "fontKey": "display",
        "fontFamily": "var(--app-font-display)",
        "fontWeight": 800,
        "textTransform": "none",
        "letterSpacing": "-0.01em"
      },
      "h4": {
        "size": "1.5rem",
        "sizePx": 24,
        "lineHeight": 1.2,
        "fontKey": "display",
        "fontFamily": "var(--app-font-display)",
        "fontWeight": 800,
        "textTransform": "none",
        "letterSpacing": "0em"
      },
      "body-lg": {
        "size": "1.25rem",
        "sizePx": 20,
        "lineHeight": 1.6,
        "fontKey": "body",
        "fontFamily": "var(--app-font-sans)",
        "fontWeight": 500,
        "textTransform": "none",
        "letterSpacing": "0em"
      },
      "body": {
        "size": "1rem",
        "sizePx": 16,
        "lineHeight": 1.5,
        "fontKey": "body",
        "fontFamily": "var(--app-font-sans)",
        "fontWeight": 400,
        "textTransform": "none",
        "letterSpacing": "0em"
      },
      "caption": {
        "size": "0.875rem",
        "sizePx": 14,
        "lineHeight": 1.5,
        "fontKey": "body",
        "fontFamily": "var(--app-font-sans)",
        "fontWeight": 700,
        "textTransform": "uppercase",
        "letterSpacing": "0.04em"
      }
    }
  },
  "spacing": {
    "0": {
      "rem": "0rem",
      "px": 0
    },
    "1": {
      "rem": "0.25rem",
      "px": 4
    },
    "2": {
      "rem": "0.5rem",
      "px": 8
    },
    "3": {
      "rem": "0.75rem",
      "px": 12
    },
    "4": {
      "rem": "1rem",
      "px": 16
    },
    "5": {
      "rem": "1.25rem",
      "px": 20
    },
    "6": {
      "rem": "1.5rem",
      "px": 24
    },
    "8": {
      "rem": "2rem",
      "px": 32
    },
    "10": {
      "rem": "2.5rem",
      "px": 40
    },
    "12": {
      "rem": "3rem",
      "px": 48
    },
    "16": {
      "rem": "4rem",
      "px": 64
    },
    "20": {
      "rem": "5rem",
      "px": 80
    },
    "24": {
      "rem": "6rem",
      "px": 96
    },
    "32": {
      "rem": "8rem",
      "px": 128
    }
  },
  "radius": {
    "base": "0.25rem",
    "scale": {
      "sm": "calc(var(--radius) - 2px)",
      "md": "var(--radius)",
      "lg": "calc(var(--radius) + 2px)",
      "xl": "calc(var(--radius) + 4px)"
    }
  },
  "shadows": {
    "light": {
      "2xs": {
        "raw": "1px 1px 0px 0px hsl(var(--foreground))",
        "resolved": "1px 1px 0px 0px #2E1C0F"
      },
      "xs": {
        "raw": "2px 2px 0px 0px hsl(var(--foreground))",
        "resolved": "2px 2px 0px 0px #2E1C0F"
      },
      "sm": {
        "raw": "4px 4px 0px 0px hsl(var(--foreground))",
        "resolved": "4px 4px 0px 0px #2E1C0F"
      },
      "DEFAULT": {
        "raw": "6px 6px 0px 0px hsl(var(--foreground))",
        "resolved": "6px 6px 0px 0px #2E1C0F"
      },
      "md": {
        "raw": "8px 8px 0px 0px hsl(var(--foreground))",
        "resolved": "8px 8px 0px 0px #2E1C0F"
      },
      "lg": {
        "raw": "12px 12px 0px 0px hsl(var(--foreground))",
        "resolved": "12px 12px 0px 0px #2E1C0F"
      },
      "xl": {
        "raw": "16px 16px 0px 0px hsl(var(--foreground))",
        "resolved": "16px 16px 0px 0px #2E1C0F"
      },
      "2xl": {
        "raw": "24px 24px 0px 0px hsl(var(--foreground))",
        "resolved": "24px 24px 0px 0px #2E1C0F"
      }
    },
    "dark": {
